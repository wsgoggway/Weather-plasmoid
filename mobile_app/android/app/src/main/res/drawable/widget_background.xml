<?xml version="1.0" encoding="utf-8"?>
<!-- Тёмный «glass»-фон виджета — как карточки приложения (радиус 20dp). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E61E1E28"
        android:endColor="#F2101018" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />
</shape>
